# ---- Python generated files ----
# Python creates these automatically when you run code.
# They are not your source code, so never commit them.
__pycache__/
*.pyc
*.pyo

# ---- Virtual environment ----
# Your local Python environment folder. Everyone creates their own.
.venv/
venv/
env/

# ---- Environment variables / secrets ----
# .env contains real API keys. NEVER commit this.
# Use .env.example as a safe template instead.
.env

# ---- Chroma vector database ----
# Generated when you build the RAG pipeline. Can be rebuilt from code.
chroma_db/

# ---- SQLite databases ----
# Generated at runtime (e.g., checkpointing database).
*.sqlite
*.db
checkpoints.sqlite
checkpoints.db
resilience/*.db
resilience/*.sqlite

# ---- Conversation transcripts ----
# These are generated at runtime and may contain user data.
transcripts/*.json
!transcripts/phase5_calibration.json
!transcripts/phase6_generation.json
!transcripts/phase7_retrieval_evaluation.json
!transcripts/phase8_application_tool.json
!transcripts/phase9_schemas.json
!transcripts/phase10_guardrails.json
!transcripts/task7_langgraph.json
!transcripts/task8_memory.json
!transcripts/task11_fastapi.json
!transcripts/task12_logging.json
!transcripts/task13_rag_triad.json
!transcripts/task14_mcp.json
!transcripts/task15_checkpointing.json
!transcripts/task16_resilience.json
!transcripts/requests.jsonl

# ---- OS generated files ----
.DS_Store
Thumbs.db

# ---- IDE / editor files ----
.vscode/
.idea/
*.swp
*.swo
