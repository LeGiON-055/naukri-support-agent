# This file is a TEMPLATE. It shows what environment variables the project needs.
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# NEVER commit the actual .env file to GitHub. It may contain real API keys.

# Set to "true" to run the project without any external API calls.
# The graded submission must work with MOCK_LLM=true.
MOCK_LLM=true

# Only needed if MOCK_LLM=false and you want to use a real LLM.
GROQ_API_KEY=your-key-here-if-using-real-llm
